# Effects (E10.3): what the sandbox's effects look like is content (`content/fx/sandbox.effect.ron`:
# sparks of a hit and of a guard, a parry's flash, a death's dust, a heal's glow), and its table
# (`content/fx/sandbox.fx.ron`) says which engine event plays which. Particles and the telegraph
# decals are the picture's: headless nothing plays and the tools say so, but the effects, their
# checks and the table are the same. It puts the decals back on.

# --- the decals on, as shipped
act telegraph_decals on=true

# --- the sandbox's effects, their pools and the table; headless nothing is drawn
act effects
expect result contains "5 effects · nothing is drawn headless: effects play in a window or with --offscreen · telegraph decals on"
expect result contains "  hit_spark    18 quad glow #fff2b3 → #ff6a1a00 · 0.2-0.4 s · aim hit · gravity -9 · pool 128"
expect result contains "  block_spark  10 shard #bfe6ff → #4d9fff00 · 0.3-0.5 s · aim hit · gravity -12 · pool 64"
expect result contains "  death_dust   16 cube + 24/s for 0.8s #8c8061cc → #5c554400 · 0.8-1.4 s · gravity -0.6 · pool 96"
expect result contains "events: blocked → block_spark · damaged → hit_spark · died → death_dust · healed → heal_glow · parried → parry_flash"
act content_get kind=effect id=death_dust
expect result contains "sandbox.effect.ron"
expect result contains "Cube"
act content_get kind=fx id=sandbox
expect result contains "sandbox.fx.ron"
expect result contains "parry_flash"

# --- headless an effect plays nowhere, and the error says why; a typo names the closest
act? effect_play effect=hit_spark at=e6
expect result contains "nothing is drawn headless: effects play in a window or with --offscreen (effect `hit_spark` is known)"
act? effect_play effect=hit_sprak at=e6
expect result contains "no effect `hit_sprak` (did you mean `hit_spark`?)"

# --- the decals off and on again, by the tool and by the developer menu's switch
act telegraph_decals on=false
expect result contains "telegraph decals off (nothing is drawn headless)"
act dev_menu
expect result contains "telegraph_decals on=true"
expect result contains "Effects, their pools and decals"
act dev_menu run=telegraph_decals
expect result contains "telegraph decals on"
act dev_menu
expect result contains "telegraph_decals on=false"

# --- an effect that would not draw is refused, and the error says why
act? content_apply changes='[{"kind": "effect", "id": "smoke", "def": {"count": 40, "max_live": 8, "color": "grey"}}]'
expect result contains "refused, it would break content: effect `smoke`: "
expect result contains "one play starts 40 particles and max_live keeps 8"
expect result contains "color: `grey` is not a colour"
act? content_apply changes='[{"kind": "fx", "id": "spare", "def": {"effects": {"damaged": "hit_sprak"}}}]'
expect result contains "a game has one table of effects, and this one has more: sandbox; keep one"
expect result contains "unknown effect `hit_sprak` (did you mean `hit_spark`?)"
act effects
expect result contains "5 effects · "
