// The player's kit (the combat prototype): a three-hit light combo, a heavy attack, a dodge
// roll, a block with a perfect-block window, and a healing flask. Times in seconds; a span is
// a whole phase, phase to phase, or Secs(from, to). Edit while the game runs: the next action
// uses the new numbers.
//
// `displacement` (how far an attack lunges, how far the roll goes) is baked from the root bone of
// the clip `bake` names (content/anim/humanoid.animset.ron): after changing the clip, bake it
// again with `cargo sandbox --bake-motion` (or `shards act motion_bake`); a stale curve is a
// content error.
//
// The combo is a chain of cancel windows: `light` pressed in light_1's recovery starts
// light_2, in light_2's recovery light_3. Light windups and recoveries can be cut short by a
// dodge or a block; the heavy attack cannot (hyper-armor while it winds up: hits do not
// stagger it).
//
// The swings whoosh as their active phase starts: a `Sound("whoosh")` effect, so it is decided on
// the simulation's clock (the same headless, in a window and on a co-op client) and not by the
// clip, which plays only where a model is drawn.
{
    "light_1": (
        net_id: 1,
        phases: [("windup", 0.2), ("active", 0.1), ("recovery", 0.3)],
        cost: (stamina: 8),
        hits: [(span: Phase("active"), shape: Cone(range: 2.2, angle: 110), damage: 20, poise: 12)],
        effects: [(at: 0.2, effect: Sound("whoosh"))],
        cancels: [
            (span: Phase("windup"), into: [Input("dodge"), Input("block")]),
            (span: Phase("recovery"), into: [Combo("light", "light_2"), Input("heavy"), Input("dodge"), Input("block")]),
        ],
        displacement: [(0.2, 0.0), (0.2167, 0.022), (0.2333, 0.078), (0.2667, 0.222), (0.2833, 0.278), (0.3, 0.3)],
        track_until: 0.15,
        anim: "light_1",
        bake: (animset: "humanoid", clip: "light_1"),
    ),
    "light_2": (
        net_id: 2,
        phases: [("windup", 0.2), ("active", 0.1), ("recovery", 0.3)],
        cost: (stamina: 8),
        hits: [(span: Phase("active"), shape: Cone(range: 2.2, angle: 110), damage: 22, poise: 14)],
        effects: [(at: 0.2, effect: Sound("whoosh"))],
        cancels: [
            (span: Phase("windup"), into: [Input("dodge"), Input("block")]),
            (span: Phase("recovery"), into: [Combo("light", "light_3"), Input("heavy"), Input("dodge"), Input("block")]),
        ],
        displacement: [(0.2, 0.0), (0.2167, 0.022), (0.2333, 0.078), (0.2667, 0.222), (0.2833, 0.278), (0.3, 0.3)],
        track_until: 0.15,
        anim: "light_2",
        bake: (animset: "humanoid", clip: "light_2"),
    ),
    "light_3": (
        net_id: 3,
        phases: [("windup", 0.25), ("active", 0.1), ("recovery", 0.45)],
        cost: (stamina: 12),
        hits: [(span: Phase("active"), shape: Cone(range: 2.4, angle: 120), damage: 30, poise: 24)],
        effects: [(at: 0.25, effect: Sound("whoosh"))],
        cancels: [
            (span: Phase("windup"), into: [Input("dodge"), Input("block")]),
            (span: Secs(0.5, 0.8), into: [Input("light"), Input("dodge"), Input("block")]),
        ],
        displacement: [(0.25, 0.0), (0.2667, 0.03), (0.2833, 0.104), (0.3167, 0.296), (0.3333, 0.37), (0.35, 0.4)],
        track_until: 0.2,
        anim: "light_3",
        bake: (animset: "humanoid", clip: "light_3"),
    ),
    // Slow, costly and hard to stop: more damage and much more poise damage.
    "heavy": (
        net_id: 4,
        phases: [("windup", 0.55), ("active", 0.15), ("recovery", 0.6)],
        cost: (stamina: 30),
        hits: [(span: Phase("active"), shape: Cone(range: 2.6, angle: 120), damage: 55, poise: 45)],
        effects: [(at: 0.55, effect: Sound("whoosh"))],
        hyper_armor: [Phase("windup")],
        cancels: [(span: Secs(0.95, 1.3), into: [Input("dodge"), Input("block"), Input("light")])],
        displacement: [(0.5, 0.0), (0.5167, 0.012), (0.5333, 0.044), (0.55, 0.094), (0.5667, 0.156), (0.5833, 0.226), (0.6167, 0.374), (0.6333, 0.444), (0.65, 0.506), (0.6667, 0.556), (0.6833, 0.588), (0.7, 0.6)],
        track_until: 0.3,
        anim: "heavy",
        bake: (animset: "humanoid", clip: "heavy"),
    ),
    // ~0.18 s of i-frames and 4 m of distance; the direction is the press's (or the
    // movement's), never pulled toward a lock-on target.
    "roll": (
        net_id: 5,
        phases: [("roll", 0.4), ("recover", 0.1)],
        cost: (stamina: 20),
        iframes: [Secs(0.0, 0.18)],
        displacement: [(0.0167, 0.372), (0.0333, 0.726), (0.05, 1.061), (0.0667, 1.379), (0.0833, 1.678), (0.1, 1.959), (0.1167, 2.222), (0.1333, 2.467), (0.15, 2.694), (0.1667, 2.902), (0.1833, 3.093), (0.2, 3.265), (0.2167, 3.42), (0.2333, 3.556), (0.25, 3.673), (0.2667, 3.773), (0.2833, 3.855), (0.3, 3.918), (0.3167, 3.964), (0.3333, 3.991), (0.35, 4.0)],
        steer: Move,
        cancels: [(span: Phase("recover"), into: [Input("light"), Input("heavy"), Input("block")])],
        anim: "roll",
        bake: (animset: "humanoid", clip: "roll"),
    ),
    // Held: the guard stays up while `block` is held. Blocked hits cost stamina (1 per point
    // of damage) and let a quarter of the damage through; with too little stamina the guard
    // breaks. Raised just in time (its first 0.15 s) it is a perfect block: no damage, no
    // stamina, and the attacker staggers.
    "block": (
        net_id: 6,
        phases: [("raise", 0.15), ("hold", 0.3), ("lower", 0.1)],
        hold: (input: "block", span: Phase("hold")),
        guard: (
            span: Phases("raise", "hold"),
            perfect: Phase("raise"),
            damage_mult: 0.25,
            stamina_per_damage: 1.0,
            poise_mult: 0.3,
            arc: 160,
        ),
        cancels: [
            (span: Phase("hold"), into: [Input("dodge")]),
            (span: Phase("lower"), into: [Input("dodge"), Input("light"), Input("heavy")]),
        ],
        move_speed: 0.4,
        anim: "block",
    ),
    // A healing flask: one charge, a short animation lock (walking slowly), 45 health at 0.7 s. It
    // has no `anim`: the model has no drinking clip, so the character walks on with its locomotion
    // clip (an `anim` no animset has is a content error).
    "drink": (
        net_id: 7,
        phases: [("drink", 1.0), ("recover", 0.3)],
        cost: (charge: "flask"),
        effects: [(at: 0.7, effect: Heal(45))],
        move_speed: 0.3,
    ),
    "player_stagger": (net_id: 8, phases: [("stagger", 0.8)], anim: "stagger"),
    "player_death": (net_id: 9, phases: [("fall", 1.2)], anim: "death"),
}
