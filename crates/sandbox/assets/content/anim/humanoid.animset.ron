// What the sandbox's characters show (content kind `animset`): the clips of the humanoid made in
// Blender by `tools/blender/humanoid.py` (models/humanoid.glb), which locomotion state and which
// action each one shows, how they blend, and their cues. The player, the skeletons and the warden
// share the one skeleton and so the one set; the warden's model is only bigger. In a window (or
// --offscreen) the sandbox dresses every character with the model; headless nothing is loaded.
//
// Gameplay leads: an action's clip is seeked to the action's progress. The player's attacks, roll,
// block and drink were made to the actions' phases (each clip carries them, in the file and here),
// and their `displacement` is baked from the clip's root bone (`bake` in combat/player.action.ron;
// `cargo sandbox --bake-motion`). A clip with `phases` is seeked phase by phase: the warden's slow
// slash shows the quick swing's windup over its own 0.6 s windup and strikes as its active phase
// starts. An action with other phases (the spar's stroke) plays its clip evenly.
{
    "humanoid": (
        source: "models/humanoid.glb",
        clips: {
            "idle": (),
            // The left heel strikes at 0, the right half a stride later.
            "walk": (cues: [(at: 0.0, cue: "footstep"), (at: 0.4, cue: "footstep")]),
            "run": (cues: [(at: 0.0, cue: "footstep"), (at: 0.3, cue: "footstep")]),
            // The swings' whoosh is not a cue: a cue sounds only where a model is drawn, and the
            // `Sound("whoosh")` effect of the actions (combat/player.action.ron) is decided on the
            // simulation's clock. Cues here are for the picture (the footsteps' dust).
            "light_1": (phases: [("windup", 0.2), ("active", 0.1), ("recovery", 0.3)]),
            "light_2": (phases: [("windup", 0.2), ("active", 0.1), ("recovery", 0.3)]),
            "light_3": (phases: [("windup", 0.25), ("active", 0.1), ("recovery", 0.45)]),
            "heavy": (phases: [("windup", 0.55), ("active", 0.15), ("recovery", 0.6)]),
            "roll": (blend: 0.04, phases: [("roll", 0.4), ("recover", 0.1)]),
            "block": (phases: [("raise", 0.15), ("hold", 0.3), ("lower", 0.1)]),
            "stagger": (name: "hit", blend: 0.04),
            "death": (),
            // The monsters' moves: the same swings on their own timelines, phase by phase (their
            // telegraphs have sounds of their own).
            "claw": (name: "light_2", phases: [("windup", 0.2), ("active", 0.1), ("recovery", 0.3)]),
            "flinch": (name: "hit", blend: 0.04),
            "slash": (name: "light_1", phases: [("windup", 0.2), ("active", 0.1), ("recovery", 0.3)]),
            "slam": (name: "heavy", phases: [("windup", 0.55), ("active", 0.15), ("recovery", 0.6)]),
            "sweep": (name: "light_3", phases: [("windup", 0.25), ("active", 0.1), ("recovery", 0.45)]),
            "shockwave": (name: "heavy", phases: [("windup", 0.55), ("active", 0.15), ("recovery", 0.6)]),
            // Clips of a second file made for the same skeleton: any character of this set can
            // play them. The drink is the flask's (see `actions`); no action of the sandbox asks
            // for the bow or the taunt yet.
            "bow": (source: "models/humanoid_gestures.glb"),
            "taunt": (source: "models/humanoid_gestures.glb"),
            "drink": (source: "models/humanoid_gestures.glb", blend: 0.12, phases: [("drink", 1.0), ("recover", 0.3)]),
        },
        // No strafe or backstep clips yet: a body locked on to a target that backs away plays its walk or
        // run backward, and one that steps to the side plays it as it is (`walk.back`, `walk.left`,
        // `idle.facing` and the rest would take over once the model has them).
        locomotion: {"idle": "idle", "walk": "walk", "run": "run", "stagger": "stagger", "dead": "death"},
        // The upper body: the spine and everything on it (the head, the arms). The legs are the rest.
        layers: {"upper": (root: "spine", off_in: ["water"])},
        // Actions find their clips by their `anim` (light_1, roll, claw, slash, ...) and play on the
        // whole body. The flask's drink is mapped here, and on the layer `upper`: the player drinks
        // while the legs go on walking or running (the drink asks for no `anim`: the action's state
        // is the simulation's, and the picture decides how to show it). The spar's roll that keeps
        // the body's facing turns the model to the roll's heading over 0.08 s (and back after it), so a
        // roll to the side under lock-on rolls that way while the body still looks at its target.
        actions: {"drink": (clip: "drink", layer: "upper"), "spar_stroke": "light_1", "spar_roll_keep": (clip: "roll", turn: 0.08)},
        // A hit and a block show on the upper body for a moment, over whatever it plays (a swing, the
        // drink, the walk): the `hit` clip from its start, in part, gone within a third of a second.
        // The picture only: the action that runs, and what it does, are the simulation's.
        overlays: {
            "damaged": (clip: "flinch", layer: "upper", fade_in: 0.04, fade_out: (0.15, 0.35), strength: 0.6),
            "blocked": (clip: "flinch", layer: "upper", fade_in: 0.04, fade_out: (0.1, 0.25), strength: 0.35),
        },
        blend: 0.2,
        action_blend: 0.06,
        // The walk's feet keep pace at 2 m/s, the run's at 4.5 m/s.
        speeds: (walk: 2.0, run: 4.5, sprint: 7.5),
        root_motion: "root",
        // Places on the skeleton a prop can sit in (a bone and a turn from it), the props a moveset
        // carries (`content/props/sandbox.prop.ron`) and where they go while an action runs. The
        // player carries a sword in the right hand; the drink puts it on the hip from 0.1 s to 0.9 s
        // of the action (the flask is in the hand then), and a roll, a flinch or a death that cuts
        // the drink leaves it there for 0.05 s of the new action. The skeletons and the warden
        // carry nothing.
        sockets: {
            "hand_r": (bone: "hand.R"),
            "hand_l": (bone: "hand.L"),
            "hip": (bone: "hips", offset: (0.2, 0.0, 0.0), turn: (0.0, 0.0, 180.0)),
            "back": (bone: "spine"),
        },
        carry: {"player": [(prop: "sword", socket: "hand_r")], "mover": [(prop: "sword", socket: "hand_r")], "*": []},
        mounts: {
            "drink": (moves: [(prop: "sword", to: Some("hip"), span: Secs(0.1, 0.9))], on_cut: {"sword": 0.05}),
            // Afloat the sword rides the back (the swimmer's arms are the strokes'), but a swing afloat (the
            // `mover` moveset's stroke) keeps it in the hand for 1.2 s after it. Leaving the water, it stays
            // on the back until the body has stood up (1 s, or its fade out of the swimming clip) and is drawn
            // back to the hand over the next 0.18 s. Spans under `@mode` count from when the rules begin.
            "@mode:water": (moves: [(prop: "sword", to: Some("back"), span: Secs(0.0, 3600.0))], yield_after: 1.2),
            "@left:water": (moves: [(prop: "sword", to: Some("back"), span: Secs(0.0, 0.18))], wait: 1.0),
        },
        // A swing afloat lowers the model by 0.15 m over 0.22 s, and back.
        drops: {"water": (down: 0.15, seconds: 0.22)},
    ),
}
