// The arena's menus on the engine's widgets: Escape (gamepad Start) opens `pause`. Every
// setting of the four groups sits on a page of `settings`; a change there is `settings_set`.
// The arena keeps its own HUD (visuals.rs), so there is no `hud` screen here. What a player reads
// is a message of the arena's languages (`@pause-resume`: assets/locale/<language>/menus.ftl),
// shown in the language played; the `language` page switches it.
{
    "pause": (
        pauses: true,
        title: "@pause-title",
        widgets: [
            Button(id: "resume", label: "@pause-resume", action: "close"),
            Button(id: "settings", label: "@pause-settings", action: "open settings"),
            Button(id: "quit", label: "@pause-quit", action: "open confirm_quit"),
        ],
    ),
    "settings": (
        title: "@settings-title",
        widgets: [
            Tabs(id: "tabs", children: [
                Panel(id: "graphics", title: "@settings-graphics", children: [
                    Toggle(id: "fullscreen", label: "@settings-fullscreen", setting: "graphics.fullscreen"),
                    Toggle(id: "vsync", label: "@settings-vsync", setting: "graphics.vsync"),
                    Slider(id: "render_scale", label: "@settings-render-scale", min: 0.5, max: 2.0, step: 0.25, setting: "graphics.render_scale"),
                    Choice(id: "shadows", label: "@settings-shadows", options: ["off", "low", "medium", "high"], setting: "graphics.shadows"),
                ]),
                Panel(id: "audio", title: "@settings-audio", children: [
                    Slider(id: "master", label: "@settings-master", min: 0.0, max: 1.0, step: 0.1, setting: "audio.master"),
                    Slider(id: "music", label: "@settings-music", min: 0.0, max: 1.0, step: 0.1, setting: "audio.music"),
                    Slider(id: "sfx", label: "@settings-sfx", min: 0.0, max: 1.0, step: 0.1, setting: "audio.sfx"),
                    Slider(id: "voice", label: "@settings-voice", min: 0.0, max: 1.0, step: 0.1, setting: "audio.voice"),
                    Slider(id: "ui", label: "@settings-ui", min: 0.0, max: 1.0, step: 0.1, setting: "audio.ui"),
                ]),
                Panel(id: "controls", title: "@settings-controls", children: [
                    Slider(id: "sensitivity", label: "@settings-look-speed", min: 0.25, max: 3.0, step: 0.25, setting: "controls.mouse_sensitivity"),
                    Toggle(id: "invert_y", label: "@settings-invert-y", setting: "controls.invert_y"),
                    Toggle(id: "hold", label: "@settings-hold", setting: "accessibility.hold_to_toggle"),
                    // The buttons of `gameplay`: confirm one and press the new key, mouse button or
                    // gamepad button (Escape cancels). It goes into `controls.bindings`; an input
                    // another action reads is refused, and the row says which.
                    Panel(id: "keys", title: "@controls-keys", children: [
                        Binding(id: "jump", label: "@controls-jump", action: "jump", prompt: "@controls-press", taken: "@controls-taken"),
                        Binding(id: "dodge", label: "@controls-dodge", action: "dodge", prompt: "@controls-press", taken: "@controls-taken"),
                        Binding(id: "light", label: "@controls-light", action: "light", prompt: "@controls-press", taken: "@controls-taken"),
                        Binding(id: "heavy", label: "@controls-heavy", action: "heavy", prompt: "@controls-press", taken: "@controls-taken"),
                        Binding(id: "block", label: "@controls-block", action: "block", prompt: "@controls-press", taken: "@controls-taken"),
                        Binding(id: "parry", label: "@controls-parry", action: "parry", prompt: "@controls-press", taken: "@controls-taken"),
                        Binding(id: "interact", label: "@controls-interact", action: "interact", prompt: "@controls-press", taken: "@controls-taken"),
                        Binding(id: "use_item", label: "@controls-use-item", action: "use_item", prompt: "@controls-press", taken: "@controls-taken"),
                        Binding(id: "lock_on", label: "@controls-lock-on", action: "lock_on", prompt: "@controls-press", taken: "@controls-taken"),
                        Binding(id: "sprint", label: "@controls-sprint", action: "sprint", prompt: "@controls-press", taken: "@controls-taken"),
                        Binding(id: "glide", label: "@controls-glide", action: "glide", prompt: "@controls-press", taken: "@controls-taken"),
                    ]),
                ]),
                Panel(id: "accessibility", title: "@settings-accessibility", children: [
                    Slider(id: "text_size", label: "@settings-text-size", min: 0.5, max: 3.0, step: 0.25, setting: "accessibility.text_scale"),
                    Choice(id: "flashes", label: "@settings-flashes", options: ["full", "reduced", "off"], setting: "accessibility.flashes"),
                    Slider(id: "shake", label: "@settings-shake", min: 0.0, max: 1.0, step: 0.1, setting: "accessibility.camera_shake"),
                    Slider(id: "blur", label: "@settings-blur", min: 0.0, max: 1.0, step: 0.1, setting: "accessibility.motion_blur"),
                    Slider(id: "hit_stop", label: "@settings-hit-stop", min: 0.0, max: 1.0, step: 0.25, setting: "accessibility.hit_stop"),
                    Slider(id: "fov", label: "@settings-fov", min: 50.0, max: 110.0, step: 5.0, setting: "accessibility.fov_deg"),
                ]),
                // A language's name is written in that language, whichever is played.
                Panel(id: "language", title: "@settings-language", children: [
                    Choice(
                        id: "game_language",
                        label: "@settings-language",
                        options: ["en", "ru"],
                        labels: ["English", "Русский"],
                        value: "en",
                        setting: "locale.language",
                    ),
                ]),
            ]),
            Button(id: "back", label: "@settings-back", action: "back"),
        ],
    ),
    "confirm_quit": (
        layer: Modal,
        title: "@quit-title",
        widgets: [
            Panel(layout: Row, children: [
                Button(id: "no", label: "@quit-no", action: "close"),
                Button(id: "yes", label: "@quit-yes", action: "quit"),
            ]),
        ],
    ),
}
