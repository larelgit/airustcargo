// The HUD and menus, on the engine's widgets (the engine draws them and moves through them):
// Escape (gamepad Start) opens `pause`. `bind` shows a value: `you.health` and `you.stamina` are
// the engine's, `trophies` the game's (src/screens.rs). `setting` is the player's setting a
// widget shows and changes. Edit them while the game runs.
{
    "hud": (
        layer: Hud,
        open_at_start: true,
        anchor: TopLeft,
        widgets: [
            Bar(id: "health", label: "HP", bind: "you.health", color: "health"),
            Bar(id: "stamina", label: "Stamina", bind: "you.stamina", color: "stamina"),
            Text(id: "trophies", bind: "trophies"),
            Hint(id: "hint", text: "[Esc] Menu"),
        ],
    ),
    "pause": (
        pauses: true,
        title: "Paused",
        widgets: [
            Button(id: "resume", label: "Resume", action: "close"),
            Button(id: "settings", label: "Settings", action: "open settings"),
            Button(id: "quit", label: "Save and quit", action: "open confirm_quit"),
        ],
    ),
    "settings": (
        title: "Settings",
        widgets: [
            Tabs(id: "tabs", children: [
                Panel(id: "display", title: "Display", children: [
                    Toggle(id: "fullscreen", label: "Fullscreen", setting: "graphics.fullscreen"),
                    Slider(id: "text_size", label: "Text size", min: 0.75, max: 2.0, step: 0.25, setting: "accessibility.text_scale"),
                    Choice(id: "flashes", label: "Flashes", options: ["full", "reduced", "off"], setting: "accessibility.flashes"),
                    Slider(id: "shake", label: "Camera shake", min: 0.0, max: 1.0, step: 0.25, setting: "accessibility.camera_shake"),
                ]),
                Panel(id: "sound", title: "Sound", children: [
                    Slider(id: "master", label: "Volume", min: 0.0, max: 1.0, step: 0.1, setting: "audio.master"),
                    Slider(id: "music", label: "Music", min: 0.0, max: 1.0, step: 0.1, setting: "audio.music"),
                ]),
                Panel(id: "controls", title: "Controls", children: [
                    Slider(id: "look", label: "Look speed", min: 0.25, max: 3.0, step: 0.25, setting: "controls.mouse_sensitivity"),
                    Toggle(id: "invert_y", label: "Invert look", setting: "controls.invert_y"),
                    Toggle(id: "hold", label: "Hold to toggle", setting: "accessibility.hold_to_toggle"),
                ]),
            ]),
            Button(id: "back", label: "Back", action: "back"),
        ],
    ),
    "confirm_quit": (
        layer: Modal,
        title: "Save and quit?",
        widgets: [
            Panel(layout: Row, children: [
                Button(id: "no", label: "Not yet", action: "close"),
                Button(id: "yes", label: "Save and quit", action: "save_and_quit"),
            ]),
        ],
    ),
}
