# The downed state (B5): a lethal hit lays a fighter down instead of killing it while another player
# still stands (the sandbox's lethal hook, `spare` in `src/gameplay/fate.rs`); a downed body takes no
# hits, starts nothing and is no target; a partner holding interact next to it stands it up (30 %
# health, 1 s of grace); left alone it bleeds out when its downed pose ends (20 s) and dies, killed
# by the one who laid it down. A player with no partner standing dies at once.
#
# Two arena fighters are borrowed: the player e5 and the skeleton e7 get the `partner` moveset
# (`content/combat/downed.*.ron`), and the skeleton fights on the player's side (team `heroes`); the
# warden e6, possessed by a dev agent (`session --subject e6`, its behaviour kept `calm`), deals the
# blows. Everything goes back at the end.

seed 42

# --- the arena as the game spawns it, whatever was played in it before: everyone stands down
act npc_set_state id=e7 state=calm
act npc_set_state id=e8 state=calm
act npc_set_state id=e14 state=calm
act npc_set_state id=e6 state=calm
# (a dead player is brought back first: its own controls refuse a dead body)
act heal id=e5
act stop
act block on=false
act lock_on off=true
act god on=false
step 150
act heal id=e5
act heal id=e6
act heal id=e7
act set id=e6 component=Boss path=phase value=1
act set id=e5 component=Fighter path=moveset value=partner
act set id=e7 component=Fighter path=moveset value=partner
act set id=e7 component=Team value=heroes
act teleport id=e5 x=3 z=0 y=0
act teleport id=e7 x=0 z=-2 y=0
act teleport id=e6 x=0 z=-4.5 y=0
act teleport id=e8 x=18 z=18 y=0
act teleport id=e14 x=-18 z=-18 y=0
step 2

session --agent warden --scope dev --subject e6
act lock_on target=e7
expect result contains "ok: locked on e7"
session --agent scenario
step 40

# --- 1. a lethal slash lays the skeleton down: no death, no health, its downed pose, no target
mark
act set id=e7 component=Health path=current value=10
session --agent warden
act light_attack
expect result contains "ok: slash"
session --agent scenario
step 60 --until "journal:e7 is down"
expect journal "e6 -> e7 slash -18 (hp 0)"
expect journal "e6 lock released: e7"
expect journal "e7 is down (bleeds out in 20.0s)"
expect !journal "e7 died"
expect field e7 Health.current == 0
expect shows e7 "downed"
expect shows e7 "spar_down"
step 90
# hits pass over a downed body
session --agent warden
act light_attack
expect result contains "ok: slash"
session --agent scenario
step 60 --until "journal:e6 -> e7"
expect journal "e6 -> e7 slash -0 (hp 0, downed)"
step 60

# --- 2. the player holds interact next to it: the revive takes it and stands it up after 3 s
mark
act teleport id=e5 x=1 z=-2 y=0
step 2
session --agent bot --scope player
act interact hold=true
expect result contains "ok: spar_revive"
session --agent scenario
step 2
expect journal "e5 takes e7 with spar_revive"
expect shows e7 "held by e5"
step 200 --until "journal:e7 revived"
expect journal "e7 revived by e5"
expect field e7 Health.current == 12
expect shows e7 "grace"
session --agent bot
act interact hold=false
session --agent scenario
step 70
act inspect id=e7
expect result !contains "grace"
expect result !contains "downed"

# --- 3. down again and left alone: it bleeds out 20 s later, killed by the warden
mark
act set id=e7 component=Health path=current value=10
session --agent warden
act light_attack
expect result contains "ok: slash"
session --agent scenario
step 60 --until "journal:e7 is down"
expect journal "e7 is down (bleeds out in 20.0s)"
step 1300 --until "journal:e7 died"
expect journal "e7 died (killed by e6)"
expect field e7 Health.current == 0
# (the skeleton's remains would go in 1.5 s: brought back at once, it stays)
act heal id=e7
step 2

# --- 4. the player with no partner standing (the skeleton is no player): a lethal slash kills it
mark
session --agent warden
act lock_on off=true
session --agent scenario
act teleport id=e5 x=0 z=-2 y=0
act teleport id=e7 x=6 z=4 y=0
step 2
session --agent warden
act lock_on target=e5
session --agent scenario
step 40
act set id=e5 component=Health path=current value=10
session --agent warden
act light_attack
expect result contains "ok: slash"
session --agent scenario
step 60 --until "journal:e5 died"
expect journal "e5 died (killed by e6 with slash)"
expect !journal "e5 is down"

# --- the arena as it was: movesets and team back, nobody locked on, everybody healed, every timer run out
session --agent warden
act lock_on off=true
session --agent scenario
act heal id=e5
act set id=e5 component=Fighter path=moveset value=player
act set id=e7 component=Fighter path=moveset value=skeleton
act set id=e7 component=Team value=monsters
act heal id=e5
act heal id=e6
act heal id=e7
act teleport id=e5 x=0 z=12 y=0
act teleport id=e7 x=-12 z=2 y=0
act teleport id=e6 x=0 z=-6 y=0
act teleport id=e8 x=12 z=-2 y=0
act teleport id=e14 x=-18 z=-18 y=0
step 200
act inspect id=e7
expect result !contains "Downed"
expect result !contains "Grace"
expect result !contains "Paired"
act inspect id=e5
expect result !contains "Pairing"
# Sixty more ticks, for the scenarios after this one in a shared game, not for this one: with
# them `npc_navmesh.scenario` starts on a tick where its den guard reaches the player. The guard
# can stop out of reach when its target stands at its leash edge, as that scenario's player does:
# the planner walks it to within 0.85 of its window of the leash-clamped goal (0.5 m short of
# the target), up to 0.5 + 0.85 * 1.84 = 2.06 m from the target, while its window ends at 1.84 m;
# where it stops depends on the tick it starts on. That is the NPC module's to fix
# (`shards_npc::planner`, `brain::clamp_to_leash`); without these ticks the shared run starts
# `npc_navmesh` on tick 21449, where the guard stops at 1.9 m and never claws.
step 60
