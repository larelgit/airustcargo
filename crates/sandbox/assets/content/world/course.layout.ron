// Area 2: the obstacle course, east of the arena (start at x = 40, end of the corridor).
// A lane 8 m wide (z -4..4) between walls:
//
//   stairs   eight 0.25 m steps up to 2 m
//   ledge    1.3 m up to the deck (a mantle: a plain jump reaches 1.2 m)
//   pool     10 m of water 2.7 m deep; climb out onto the far deck
//   ramp     up to the cliff top at 8 m
//   cliff    18 m above the canyon floor; the goal pad is 32 m across the gap, on a rock
//            2 m lower: only a glide gets there, and only with the lift of the updraft half
//            way across
//
// Landmarks for the AI: Stairs e9, Ledge e10, Pool e11, Cliff e12, and the goal pad Goal e13
// (a trigger volume: entering it journals `e5 reached goal`).
{
    "course": (
        solids: [
            // Stairs: each step a block from its front edge to the plateau's end.
            (min: (44.0, 0.0, -4.0), max: (52.0, 0.25, 4.0)),
            (min: (44.5, 0.0, -4.0), max: (52.0, 0.5, 4.0)),
            (min: (45.0, 0.0, -4.0), max: (52.0, 0.75, 4.0)),
