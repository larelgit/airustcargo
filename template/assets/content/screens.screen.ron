// The HUD and menus, on the engine's widgets (the engine draws them and moves through them): the
// main menu comes up after loading, Escape (gamepad Start) opens `pause` in the game. `bind` shows a
// value: `you.health` and `you.stamina` are the engine's, `trophies` and `continue_note` the game's
// (src/screens.rs). `setting` is the player's setting a widget shows and changes. A text that starts
// with `@` is a message of the game's languages (assets/locale/<language>/game.ftl), shown in the one
// played. Edit them while the game runs.
{
    // The main menu (`main_menu: true`), after loading, with a window or --offscreen (`--menu` without
    // either; tests and replays go straight into the game). Time stands still until `new_game` starts
    // the game as a run without the menu does, or `continue_game` starts it and loads the newest save.
    // `continue_note` (src/screens.rs) says why there is nothing to continue.
    "main_menu": (
        main_menu: true,
        closable: false,
        title: "@menu-title",
        widgets: [
            Image(id: "art", path: "ui/loading.png", label: "@menu-art", width: 400.0),
            Button(id: "new_game", label: "@menu-new-game", action: "tool new_game"),
            Button(id: "continue", label: "@menu-continue", action: "tool continue_game"),
            Hint(id: "no_save", bind: "continue_note"),
            Button(id: "settings", label: "@menu-settings", action: "open settings"),
            Button(id: "quit", label: "@menu-quit", action: "quit"),
        ],
    ),
    "hud": (
        layer: Hud,
        open_at_start: true,
        anchor: TopLeft,
        widgets: [
            Bar(id: "health", label: "@hud-health", bind: "you.health", color: "health"),
            Bar(id: "stamina", label: "@hud-stamina", bind: "you.stamina", color: "stamina"),
            Text(id: "trophies", bind: "trophies"),
            Hint(id: "hint", text: "@hud-hint"),
        ],
    ),
    "pause": (
        pauses: true,
        title: "@pause-title",
        widgets: [
            Button(id: "resume", label: "@pause-resume", action: "close"),
            Button(id: "settings", label: "@pause-settings", action: "open settings"),
            Button(id: "quit", label: "@pause-quit", action: "open confirm_quit"),
        ],
    ),
    "settings": (
        title: "@settings-title",
        widgets: [
            Tabs(id: "tabs", children: [
                Panel(id: "display", title: "@settings-display", children: [
                    Toggle(id: "fullscreen", label: "@settings-fullscreen", setting: "graphics.fullscreen"),
                    Slider(id: "text_size", label: "@settings-text-size", min: 0.75, max: 2.0, step: 0.25, setting: "accessibility.text_scale"),
                    Choice(
                        id: "flashes",
                        label: "@settings-flashes",
                        options: ["full", "reduced", "off"],
                        labels: ["@flashes-full", "@flashes-reduced", "@flashes-off"],
                        setting: "accessibility.flashes",
                    ),
                    Slider(id: "shake", label: "@settings-shake", min: 0.0, max: 1.0, step: 0.25, setting: "accessibility.camera_shake"),
                ]),
                Panel(id: "sound", title: "@settings-sound", children: [
                    Slider(id: "master", label: "@settings-volume", min: 0.0, max: 1.0, step: 0.1, setting: "audio.master"),
                    Slider(id: "music", label: "@settings-music", min: 0.0, max: 1.0, step: 0.1, setting: "audio.music"),
                    Slider(id: "sfx", label: "@settings-sfx", min: 0.0, max: 1.0, step: 0.1, setting: "audio.sfx"),
                    Slider(id: "ui", label: "@settings-ui", min: 0.0, max: 1.0, step: 0.1, setting: "audio.ui"),
                ]),
                Panel(id: "controls", title: "@settings-controls", children: [
                    Slider(id: "look", label: "@settings-look", min: 0.25, max: 3.0, step: 0.25, setting: "controls.mouse_sensitivity"),
                    Toggle(id: "invert_y", label: "@settings-invert", setting: "controls.invert_y"),
                    Toggle(id: "hold", label: "@settings-hold", setting: "accessibility.hold_to_toggle"),
                    // The hero's buttons: confirm a row and press the new key, mouse button or
                    // gamepad button (Escape cancels). The change is saved in `controls.bindings`;
                    // an input another action reads is refused, and the row says which.
                    Panel(id: "keys", title: "@controls-keys", children: [
                        Binding(id: "jump", label: "@controls-jump", action: "jump", prompt: "@controls-press", taken: "@controls-taken"),
                        Binding(id: "dodge", label: "@controls-dodge", action: "dodge", prompt: "@controls-press", taken: "@controls-taken"),
                        Binding(id: "light", label: "@controls-light", action: "light", prompt: "@controls-press", taken: "@controls-taken"),
                        Binding(id: "heavy", label: "@controls-heavy", action: "heavy", prompt: "@controls-press", taken: "@controls-taken"),
                        Binding(id: "block", label: "@controls-block", action: "block", prompt: "@controls-press", taken: "@controls-taken"),
                        Binding(id: "parry", label: "@controls-parry", action: "parry", prompt: "@controls-press", taken: "@controls-taken"),
                        Binding(id: "interact", label: "@controls-interact", action: "interact", prompt: "@controls-press", taken: "@controls-taken"),
                        Binding(id: "use_item", label: "@controls-use-item", action: "use_item", prompt: "@controls-press", taken: "@controls-taken"),
                        Binding(id: "lock_on", label: "@controls-lock-on", action: "lock_on", prompt: "@controls-press", taken: "@controls-taken"),
                        Binding(id: "sprint", label: "@controls-sprint", action: "sprint", prompt: "@controls-press", taken: "@controls-taken"),
                        Binding(id: "glide", label: "@controls-glide", action: "glide", prompt: "@controls-press", taken: "@controls-taken"),
                    ]),
                ]),
                // A language's name is written in that language, whichever is played; `value` is
                // what shows while the player has not picked one (the game's own, English).
                Panel(id: "language", title: "@settings-language", children: [
                    Choice(
                        id: "game_language",
                        label: "@settings-language",
                        options: ["en", "ru"],
                        labels: ["English", "Русский"],
                        value: "en",
                        setting: "locale.language",
                    ),
                ]),
            ]),
            Button(id: "back", label: "@settings-back", action: "back"),
        ],
    ),
    "confirm_quit": (
        layer: Modal,
        title: "@quit-title",
        widgets: [
            Panel(layout: Row, children: [
                Button(id: "no", label: "@quit-no", action: "close"),
                Button(id: "yes", label: "@quit-yes", action: "save_and_quit"),
            ]),
        ],
    ),
}
