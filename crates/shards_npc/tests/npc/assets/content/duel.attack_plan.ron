// Plans of the duel rules: one jab (54 ticks long), rests of whole half-seconds.
{
    // The reference: a rest of 0.5 s counted while the NPC runs no action.
    "rest_plain": (options: [(input: "light")], rest: (0.5, 0.5)),
    // Counted in every state: a stagger after the attack is part of the rest.
    "rest_busy": (options: [(input: "light")], rest: (0.5, 0.5), rest_runs_while_busy: true),
    // A cut-short attack rests 0.3 s, a finished one 0.5 s.
    "rest_interrupted": (options: [(input: "light")], rest: (0.5, 0.5), rest_interrupted: Some((0.3, 0.3))),
    // A pause of a second at spawn.
    "rest_first": (options: [(input: "light")], rest: (0.5, 0.5), first_rest: Some((1.0, 1.0))),
    // Two NPCs on this plan keep wanting to strike.
    "pair": (options: [(input: "light")], rest: (0.1, 0.1)),
    // A retreat, tagged by its action as a repositioning.
    "hopper": (options: [(input: "hop", max: Some(5.0))], rest: (0.1, 0.1)),
}
