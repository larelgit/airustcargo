# The boss scheduler (N8a2, N8b, N8c): an option of an attack plan carries an angle window, a player-count
# window, a repeat limit and a `forbid_after` tag, one judge asks them for the director's grant and the
# planner alike, and `npc_schedule` says why an option is refused. The warden fights on two plans (one
# per phase, the way the sandbox's phase system swaps them) that are tokenless (it shares the skeletons'
# director and takes none of their tokens), never wait for the spacing, and wait in a strafe of their own
# while they rest or have nothing in reach. The definitions are written here with `content_apply` and
# taken away again at the end, so the sandbox's own content (and the other reference replays' content) is
# what it was. The engine rules `npc.tokens_within_limit`, `npc.strike_spacing` and `npc.plan_sequence`
# judge every tick: a violation stops the step and fails the run. (The warden's behaviour has no `think`
# cadence, so `press_on_decision` there decides every tick.) What the plan remembers is the game's to
# control: `npc_plan_cooldown` and `npc_plan_reset` call the API a game calls (N8c).

seed 42

# --- the world as the game spawns it, whatever was played in it before
act npc_set_state id=e7 state=calm
act npc_set_state id=e8 state=calm
act npc_set_state id=e14 state=calm
act npc_set_state id=e6 state=calm
act heal id=e5
act stop
act block on=false
act lock_on off=true
step 120
act heal id=e5
act heal id=e6
act set id=e6 component=Boss path=phase value=1
act set id=e6 component=NpcPlan value='{"history": [], "cooldowns": [], "rest": 0.5, "attacks": 0}'

# --- the definitions: a director with two tokens that spaces strikes 0.7 s, a fighting behaviour without a leash, the
# skeletons' claw as a plan, and the warden's four inputs as options with a gate each (every window holds 1.5 m, so the
# range never decides what the checks below read); the boss plans are tokenless and wait in a strafe of their own
act content_apply changes='[{"kind": "director", "id": "sched_arena", "def": {"tokens": {"1": 2}, "waiting": [{"role": "Hold", "distance": 4.0}], "patience": 3.0, "min_spacing": 0.7}}, {"kind": "behavior", "id": "sched_fight", "def": {"initial": "idle", "states": {"idle": {"transitions": [{"to": "fight", "when": ["target_known"]}]}, "fight": {"kind": "attack", "transitions": [{"to": "idle", "when": ["target_lost"]}]}}}}, {"kind": "attack_plan", "id": "sched_add", "def": {"options": [{"input": "light", "tags": ["light"]}], "rest": [0.6, 1.0]}}, {"kind": "attack_plan", "id": "sched_boss", "def": {"options": [{"input": "light", "weight": 3.0, "max": 3.0, "max_repeats": 2, "tags": ["melee"]}, {"input": "heavy", "weight": 1.4, "max": 3.2, "cooldown": 4.0, "tags": ["zone"], "forbid_after": ["zone"], "forbid_while": ["capture"]}, {"input": "technique.1", "weight": 4.0, "max": 3.0, "cooldown": 3.0, "angle": [95.0, 180.0]}, {"input": "technique.2", "weight": 1.0, "max": 6.0, "players": [2, 3]}], "in_range_only": true, "press_on_decision": true, "rest": [0.6, 1.0], "tokenless": true, "ignores_spacing": true, "wait": {"role": "Strafe", "distance": 2.2, "speed": 1.0, "orbit": 1.6, "period": 1.875}}}, {"kind": "attack_plan", "id": "sched_boss_enraged", "def": {"options": [{"input": "light", "weight": 3.0, "max": 3.0, "max_repeats": 2, "tags": ["melee"]}, {"input": "heavy", "weight": 1.4, "max": 3.2, "cooldown": 4.0, "tags": ["zone"], "forbid_after": ["zone"], "forbid_while": ["capture"]}, {"input": "technique.1", "weight": 4.0, "max": 3.0, "cooldown": 3.0, "angle": [95.0, 180.0]}, {"input": "technique.2", "weight": 1.0, "max": 6.0, "players": [2, 3]}], "in_range_only": true, "press_on_decision": true, "rest": [0.3, 0.6], "tokenless": true, "ignores_spacing": true, "wait": {"role": "Strafe", "distance": 2.2, "speed": 1.0, "orbit": 1.6, "period": 1.875}}}]'

# --- the cast: the warden on the new plans and the arena's director, the two skeletons beside the player on the same
# director (their behaviour is the leashless one)
act set id=e6 component=Boss path=plans value='["sched_boss", "sched_boss_enraged"]'
act set id=e6 component=Npc path=director value=sched_arena
act set id=e7 component=Npc path=behavior value=sched_fight
act set id=e7 component=Npc path=director value=sched_arena
act set id=e7 component=Npc path=plan value=sched_add
act set id=e8 component=Npc path=behavior value=sched_fight
act set id=e8 component=Npc path=director value=sched_arena
act set id=e8 component=Npc path=plan value=sched_add
act teleport id=e5 x=0 z=-3.5 y=0
act teleport id=e6 x=0 z=-6 y=0
act teleport id=e7 x=-4 z=-1 y=0
act teleport id=e8 x=4 z=-1 y=0
act teleport id=e14 x=-18 z=-18 y=0
act god
act npc_set_state id=e6 state=guard
step 30
invariant field e5 Health.current > 0

# --- 1. the explanation: the same judge as the planner, against any angle and any player count
# (nothing moves, and the distance is fixed so that the range decides nothing)
# The plan starts clean, so no cooldown refuses what the checks below read.
act set id=e6 component=NpcPlan value='{"history": [], "cooldowns": [], "rest": 0.5, "attacks": 0}'
act npc_schedule id=e6 target=e5 distance=1.5 angle=150
expect result contains "\"what_if\": true"
expect result contains "\"tokenless\": true"
expect result contains "\"eligible\": true"
expect result !contains "angle:"
act npc_schedule id=e6 target=e5 distance=1.5 angle=10
expect result contains "angle: the target is 10 degrees off the facing; this option needs 95-180"
act npc_schedule id=e6 target=e5 distance=1.5 players=2
expect result contains "\"eligible\": true"
expect result !contains "players: "
act npc_schedule id=e6 target=e5 distance=1.5
expect result contains "players: 1 living, this option needs 2-3"
act? npc_schedule id=e6 target=e5 distance=1.5 angle=200
expect result contains "angle must be 0..180 degrees (is 200)"

# --- 1b. live tags (N8d): `heavy` is not chosen while a capture is live. The skeleton e8 is borrowed as a caster
# (the `caster` moveset of objects.scenario, presses from a dev agent possessing it): its homing bolt meets the player
# and bursts into a chilling puddle at the player's feet (`chill_puddle`, tagged `capture`: active 3 s, then a fade). The warden
# stands down meanwhile, so the player can take the bolt out of god mode.
act npc_set_state id=e6 state=calm
act god on=false
act heal id=e8
act set id=e8 component=Fighter path=moveset value=caster
act teleport id=e8 x=8 z=-3.5 y=0
step 2
session --agent caster --scope dev --subject e8
act lock_on target=e5
expect result contains "ok: locked on e5"
session --agent scenario
step 31
session --agent caster
act light_attack
expect result contains "ok: caster_volley"
session --agent scenario
step 150 --until "journal:e8 -> e5 bolt_fly"
expect journal "e8 -> e5 bolt_fly"
step 2
act combat_objects owner=e8
expect result contains "chill_puddle"
act set id=e6 component=NpcPlan value='{"history": [], "cooldowns": [], "rest": 0.5, "attacks": 0}'
act npc_schedule id=e6 target=e5 distance=1.5
expect result contains "live: capture is live (forbid_while)"
expect result contains "\"live\""
# the same judge, told that nothing is live
act npc_schedule id=e6 target=e5 distance=1.5 live=[]
expect result !contains "live: capture"
# in its fade the puddle is no longer live
step 190
act npc_schedule id=e6 target=e5 distance=1.5
expect result !contains "live: capture"
expect result !contains "\"live\""
# the caster goes back to being a skeleton, the player to god mode and the warden to its guard
session --agent caster
act lock_on off=true
session --agent scenario
act set id=e8 component=Fighter path=moveset value=skeleton
act teleport id=e8 x=4 z=-1 y=0
act heal id=e5
act heal id=e8
act npc_set_state id=e6 state=guard
act god
step 120
act combat_objects owner=e8
expect result !contains "chill_puddle"

# --- 2. the fight: the skeletons take the director's tokens, the warden none, and the gates hold over a long run
# (the rule `npc.plan_sequence` judges every press, `npc.strike_spacing` the strikes of the skeletons)
act npc_set_state id=e7 state=idle
act npc_set_state id=e8 state=idle
mark
step 900
expect result !contains "stopped: invariant"
expect journal "e6 -> e5"
expect journal "e7 takes an attack token on e5"
expect !journal "e6 takes an attack token"
expect !journal "e6 returns its attack token"
act npc_state id=e6
expect result contains "\"repeats\""
expect result contains "\"tokenless\": true"
act npc_schedule id=e6 target=e5 distance=1.5
expect result contains "\"history\""

# --- 3. its grant is outside the books: while it attacks, the state says the token is not counted
step 600 --until "journal:e6 -> e5"
act npc_state id=e6
expect result contains "\"counted\": false"

# --- 4. the phase change swaps the plan and keeps what the plan remembers: the cooldown of `heavy`
# is the same option in both
act npc_plan_cooldown id=e6 option=heavy seconds=10
expect result contains "e6 heavy: cooldown 10.00 s"
act set id=e6 component=Health path=current value=290
step 2
act npc_state id=e6
expect result contains "\"id\": \"sched_boss_enraged\""
expect result contains "\"heavy\": 9.9"
act npc_schedule id=e6 target=e5 distance=1.5
expect result contains "cooldown: 9.9"

# --- 5. what the plan remembers is the game's to control (N8c): a phase that really resets an option sets its
# cooldown to nothing, and a boss home again forgets its history and its cooldowns
act npc_plan_cooldown id=e6 option=heavy seconds=0
expect result contains "e6 heavy: cooldown 0.00 s (was 9.9"
expect journal "e6 heavy cooldown 0.00 s (was 9.9"
act? npc_plan_cooldown id=e6 option=hevy seconds=0
expect result contains "has no option `hevy` (did you mean `heavy`?)"
step 600
expect result !contains "stopped: invariant"
act npc_plan_reset id=e6
expect result contains "e6 plan reset: "
expect journal "e6 plan reset (npc_plan_reset): "
act npc_state id=e6
expect result contains "\"history\": []"
step 300
expect result !contains "stopped: invariant"

# --- back as it was
act god on=false
act set id=e6 component=Boss path=plans value='["warden", "warden_enraged"]'
act set id=e6 component=Boss path=phase value=1
act set id=e6 component=Npc path=director value=boss
act set id=e7 component=Npc path=behavior value=skeleton
act set id=e7 component=Npc path=director value=""
act set id=e7 component=Npc path=plan value=skeleton
act set id=e8 component=Npc path=behavior value=skeleton
act set id=e8 component=Npc path=director value=""
act set id=e8 component=Npc path=plan value=skeleton
act heal id=e6
act heal id=e5
act npc_plan_reset id=e7
act npc_plan_reset id=e8
act set id=e6 component=NpcPlan value='{"history": [], "cooldowns": [], "rest": 0.5, "attacks": 0}'
act npc_set_state id=e6 state=calm
act npc_set_state id=e7 state=calm
act npc_set_state id=e8 state=calm
act teleport id=e7 x=-18 z=18 y=0
act teleport id=e8 x=18 z=18 y=0
step 2
act npc_state id=e6
expect result contains "\"id\": \"warden\""
act content_apply changes='[{"kind": "director", "id": "sched_arena", "before": {"tokens": {"1": 2}, "waiting": [{"role": "Hold", "distance": 4.0}], "patience": 3.0, "min_spacing": 0.7}}, {"kind": "behavior", "id": "sched_fight", "before": {"initial": "idle", "states": {"idle": {"transitions": [{"to": "fight", "when": ["target_known"]}]}, "fight": {"kind": "attack", "transitions": [{"to": "idle", "when": ["target_lost"]}]}}}}, {"kind": "attack_plan", "id": "sched_add", "before": {"options": [{"input": "light", "tags": ["light"]}], "rest": [0.6, 1.0]}}, {"kind": "attack_plan", "id": "sched_boss", "before": {"options": [{"input": "light", "weight": 3.0, "max": 3.0, "max_repeats": 2, "tags": ["melee"]}, {"input": "heavy", "weight": 1.4, "max": 3.2, "cooldown": 4.0, "tags": ["zone"], "forbid_after": ["zone"], "forbid_while": ["capture"]}, {"input": "technique.1", "weight": 4.0, "max": 3.0, "cooldown": 3.0, "angle": [95.0, 180.0]}, {"input": "technique.2", "weight": 1.0, "max": 6.0, "players": [2, 3]}], "in_range_only": true, "press_on_decision": true, "rest": [0.6, 1.0], "tokenless": true, "ignores_spacing": true, "wait": {"role": "Strafe", "distance": 2.2, "speed": 1.0, "orbit": 1.6, "period": 1.875}}}, {"kind": "attack_plan", "id": "sched_boss_enraged", "before": {"options": [{"input": "light", "weight": 3.0, "max": 3.0, "max_repeats": 2, "tags": ["melee"]}, {"input": "heavy", "weight": 1.4, "max": 3.2, "cooldown": 4.0, "tags": ["zone"], "forbid_after": ["zone"], "forbid_while": ["capture"]}, {"input": "technique.1", "weight": 4.0, "max": 3.0, "cooldown": 3.0, "angle": [95.0, 180.0]}, {"input": "technique.2", "weight": 1.0, "max": 6.0, "players": [2, 3]}], "in_range_only": true, "press_on_decision": true, "rest": [0.3, 0.6], "tokenless": true, "ignores_spacing": true, "wait": {"role": "Strafe", "distance": 2.2, "speed": 1.0, "orbit": 1.6, "period": 1.875}}}]'
act content_list kind=attack_plan
expect result !contains "sched_boss"
act content_list kind=director
expect result !contains "sched_arena"
