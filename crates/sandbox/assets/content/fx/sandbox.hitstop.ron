// The sandbox's hit stop (content kind `hitstop`, one per game): how long the picture stands still
// when a blow lands. The first rule that matches a combat event gives its hold, in seconds; an
// event no rule matches gives none. This is a neutral example: a game writes its own ladder.
//
// A hold is a pause, never slow motion: played alone with a picture it keeps the real-time clock
// still (no tick runs inside it); in co-op only the pictures of the bodies in the blow stand still;
// headless, stepped and in a replay nothing is held (`hitstop` says why). The player's scale
// (`accessibility.hit_stop`, 0 turns it off) and `max_seconds` bound every hold.
{
    "sandbox": (
        max_seconds: 0.12,
        // After a hold is over, a new one waits this long (s), so a flurry does not stutter.
        cooldown: 0.0,
        rules: [
            (name: "finisher", when: (event: Damaged, weight_at_least: Finisher), seconds: 0.10),
            (name: "poise break", when: (event: Damaged, weight_at_least: Break), seconds: 0.10),
            (name: "counter", when: (event: Damaged, weight_at_least: Counter), seconds: 0.08),
            (name: "heavy hit", when: (event: Damaged, reaction_at_least: 2), seconds: 0.08),
            (name: "hit", when: (event: Damaged), seconds: 0.06),
            (name: "block", when: (event: Blocked), seconds: 0.06),
            (name: "parry", when: (event: Parried), seconds: 0.10),
            (name: "perfect dodge", when: (event: PerfectEvaded), seconds: 0.10),
        ],
    ),
}
