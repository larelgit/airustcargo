{
    // A body hit only through its parts (its own capsule takes nothing), all in front of its
    // middle: an arm before its right shoulder with its own 60 hp, which doubles a hit and passes
    // half of it to the body; a left leg without health that triples poise; a weak spot that starts
    // off; a crown out of a sword's reach.
    "giant": (
        body_hurtbox: false,
        parts: {
            "arm": (shape: Sphere(radius: 0.4), at: (forward: 0.8, up: 1.0, right: 0.5), health: Some(60), damage: 2.0, to_body: 0.5),
            "crown": (shape: Sphere(radius: 0.5), at: (up: 6.0), health: Some(10)),
            "leg": (shape: Capsule(half_height: 0.4, radius: 0.3), at: (forward: 0.5, up: 0.7, right: -0.5), poise: 3.0),
            "spot": (shape: Sphere(radius: 0.3), at: (forward: 0.9, up: 1.0), tags: ["weak"], enabled: false),
        },
    ),
    // A chest straight ahead at 1.5 m and a shin off to the side at 0.3 m: the shin is nearer the
    // attacker's feet, the chest nearer the middle of its swing (half way up the cone).
    "tall": (
        body_hurtbox: false,
        parts: {
            "chest": (shape: Sphere(radius: 0.35), at: (forward: 0.9, up: 1.5)),
            "shin": (shape: Sphere(radius: 0.3), at: (forward: 0.7, up: 0.3, right: 0.6)),
        },
    ),
    // Lock points (R3): a body taken by the lock-on only through its parts. Two on the line ahead of it
    // (the front one nearer the middle of a swing at it), a hand off to its right with 20 hp, a leg off
    // to its left, and a crest that is no lock point.
    "pointed": (
        body_hurtbox: false,
        lock_body: false,
        parts: {
            "back": (shape: Sphere(radius: 0.3), at: (forward: 0.6, up: 0.8), lock: true),
            "crest": (shape: Sphere(radius: 0.3), at: (up: 3.0)),
            "front": (shape: Sphere(radius: 0.3), at: (forward: 1.2, up: 0.8), lock: true),
            "hand": (shape: Sphere(radius: 0.3), at: (forward: 1.0, up: 1.0, right: 1.0), health: Some(20), lock: true),
            "leg": (shape: Sphere(radius: 0.3), at: (forward: 1.0, up: 0.6, right: -1.0), lock: true),
        },
    ),
    // One part on a body whose own capsule still takes hits.
    "open": (parts: {"arm": (shape: Sphere(radius: 0.3), at: (forward: 0.8, up: 1.0, right: 0.5))}),
}
