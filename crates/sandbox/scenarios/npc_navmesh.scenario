# An enemy on the navmesh (E6): in the generated region (`content/region/`), the den guard
# sees the player through the pillar hall's colonnade, walks around the columns by the
# navmesh to strike, and turns back at its leash (10 m from its den) when the player walks
# off. The region's monsters come with the region, after whatever was spawned before it, so
# they have no fixed ids: the scenario follows them by the journal and the engine's NPC stop
# conditions, `npc_detour` (an NPC walks a planned route around something in its way) and
# `npc_beyond_leash` (an NPC stands outside its zone), which must never hold.
#
# The hall is fixed by the region's content at cell (5, 5): its colonnade runs x 19..29 at
# z 135..137, the den is at (24, 140), south of it.
#
# Every wait below waits on the event it means, not on a tick count, so the scenario does not
# lean on the tick it starts at (the NPC dice are keyed by tick). Measured live and in-process
# from 100+ start ticks (0 to 65537, also after the whole scenarios folder and twice in a row):
# the detour is planned 2 ticks after the mark, the claw lands 330 ticks later, "fight → home"
# 29 ticks after the walk-off and "home → idle" 258 ticks after that, the same from every start
# tick. The budgets (600, 900, 600, 900) are at least 2.7 times the measured worst case.

seed 42

# --- setup (dev): the wilds of seed 42, the player unhurtable in the hall north of the columns
act regen region=wilds seed=42
expect result contains "ok: wilds seed 42 v1"
act heal id=e5
act stop
act block on=false
act lock_on off=true
act god
act teleport id=e5 x=24 z=130 y=0
mark

# --- 1. the guard sees the player through the columns; the straight way is blocked: around
step 600 --until named:npc_detour
expect stopped "npc_detour"
expect journal "idle → fight e5"
session --agent scout --scope player
# what the navmesh says of that walk (the player's own query): around the columns, with
# turns, longer than the 10 m straight through them
act nav_path from='{"x": 24, "z": 140}' to=e5
expect result contains "\"provider\": \"navmesh\""
expect result contains " turns: "
expect result !contains "path 10.0m"
# and the player's own way to the den: `path_to` asks the region's navmesh first
act path_to target='{"x": 24, "z": 140}'
expect result contains "\"provider\": \"navmesh\""
expect result !contains "path 10.0m"
session --agent scenario
# the NPC overlay (F7 in a window) says what the guard has on its mind: the player, its
# leash, and the way around
act npc_overlay
expect result contains "fight e5"
expect result contains "/10m"
expect result contains "detour, "
act npc_overlay on=false
# around the columns to the player, and a claw; never out of its zone on the way
step 900 --until "journal:-> e5 claw" --until named:npc_beyond_leash
expect stopped "-> e5 claw"

# --- 2. the player walks off north, out of the guard's leash: it follows to the edge of its
# zone, no farther, and turns back to its den
session --agent scout
act move_to target='{"x": 24, "z": 112}' within=0.5
expect result contains "ok: move_to"
session --agent scenario
step 600 --until "journal:fight → home e5" --until named:npc_beyond_leash
expect stopped "fight → home e5"
# it is home and idle again, still inside its zone the whole way back, and it stays there
step 900 --until "journal:home → idle" --until named:npc_beyond_leash
expect stopped "home → idle"
step 600 --until named:npc_beyond_leash
expect result contains "no condition met"
act god on=false
