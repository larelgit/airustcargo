// Behaviours of the duel rules. `probe` is the test's own state hook: it counts the ticks it
// was allowed to decide on in `NpcBrain.step`.
{
    // A decision every 0.15 s of free time.
    "thinker": (initial: "probe", think: Some(0.15), states: {"probe": ()}),
    // The same without a cadence: it decides every tick.
    "eager": (initial: "probe", states: {"probe": ()}),
    // A transition that waits for a decision tick.
    "gated": (
        initial: "a",
        think: Some(0.25),
        states: {
            "a": (kind: "probe", transitions: [(to: "b", when: ["deciding"])]),
            "b": (kind: "probe", transitions: [(to: "a", when: ["deciding"])]),
        },
    ),
    // Presses a strike itself (the test's hook `press_when_ready`), with no token.
    "presser": (initial: "go", states: {"go": (kind: "press_when_ready")}),
    // Fights; below half health it enters `rage_fight`, which clamps the plan's rest to 0.1 s once.
    "raging": (
        initial: "fight",
        states: {
            "fight": (kind: "attack", transitions: [(to: "rage_fight", when: [("health_below", {"fraction": 0.5})])]),
            "rage_fight": (kind: "attack", rest_clamp: Some(0.1)),
        },
    ),
    // The same, with a hook that sets the cap itself, once, on entering.
    "hooked": (
        initial: "fight",
        states: {
            "fight": (kind: "attack", transitions: [(to: "rage_fight", when: [("health_below", {"fraction": 0.5})])]),
            "rage_fight": (kind: "cap_rest"),
        },
    ),
    // Presses a strike whenever it is free, without asking the spacing (the test's hook `unruly`).
    "unruly_fighter": (initial: "go", states: {"go": (kind: "unruly")}),
    // Every rule of the duel at once: a cadence and a rest clamp, and the plan's own rules.
    "everything": (
        initial: "fight",
        think: Some(0.15),
        states: {
            "fight": (kind: "attack", rest_clamp: Some(0.3)),
        },
    ),
    // Presses a strike on its second tick, which is when a planner NPC takes its first token (test hook `press_at_two`).
    "presser_at_two": (initial: "go", states: {"go": (kind: "press_at_two")}),
    // Fights like `grunt`, deciding every 0.15 s of free time.
    "grunt_think": (
        initial: "idle",
        think: Some(0.15),
        states: {
            "idle": (transitions: [(to: "fight", when: ["target_known"])]),
            "fight": (kind: "attack", transitions: [(to: "idle", when: ["target_lost"])]),
        },
    ),
}
