# NPC rules for duels (N1-N6): strike spacing between the monsters of one director, a plan
# with conditional options, a combo chain, rest semantics, a decision cadence and a perception
# keep range. The rules are the engine's, the numbers are definitions the scenario adds with
# `content_apply` and takes away again at the end, so the sandbox's own content (and the
# reference replays' content hash) is what it was. The skeletons fight by a director that
# starts their claws at least 0.7 s (42 ticks) apart; the engine rule `npc.strike_spacing`
# judges every tick (a violation stops the step and fails the run).

seed 42

# --- the world as the game spawns it, whatever was played in it before
act npc_set_state id=e7 state=calm
act npc_set_state id=e8 state=calm
act npc_set_state id=e14 state=calm
act npc_set_state id=e6 state=calm
act heal id=e5
act stop
act block on=false
act lock_on off=true
step 120

# --- the definitions: a spaced director with three tokens, a plan that uses the rest rules and
# a condition on its option, a behaviour with a decision cadence, a perception that keeps what it
# has seen farther out than it notices
act content_apply changes='[{"kind": "director", "id": "duel_spaced", "def": {"tokens": {"1": 3}, "waiting": [{"role": "Hold", "distance": 4.0}], "patience": 3.0, "min_spacing": 0.7, "spacing_exempt_tags": ["reposition"]}}, {"kind": "attack_plan", "id": "duel_skeleton", "def": {"options": [{"input": "light", "tags": ["light"], "when": [["!health_below", {"fraction": 0.05}]]}], "rest": [0.5, 0.8], "rest_interrupted": [0.2, 0.3], "first_rest": [0.2, 0.4]}}, {"kind": "behavior", "id": "duel_fight", "def": {"initial": "idle", "think": 0.15, "states": {"idle": {"transitions": [{"to": "fight", "when": ["target_known"]}]}, "fight": {"kind": "attack", "transitions": [{"to": "idle", "when": ["target_lost"]}]}}}}, {"kind": "perception", "id": "duel_eyes", "def": {"sight_range": 18.0, "fov_deg": 360.0, "near": 3.0, "hearing": 1.0, "memory": 6.0, "keep_range": 24.0}}]'

# --- the arena: the player in the south half, the three skeletons 5 m away, all on the new ids
act teleport id=e6 x=0 z=-6 y=0
act teleport id=e5 x=0 z=8 y=0
act teleport id=e7 x=-5 z=8 y=0
act teleport id=e8 x=5 z=8 y=0
act teleport id=e14 x=0 z=13 y=0
act heal id=e7
act heal id=e8
act heal id=e14
act god
act set id=e7 component=Npc path=behavior value=duel_fight
act set id=e7 component=Npc path=perception value=duel_eyes
act set id=e7 component=Npc path=director value=duel_spaced
act set id=e7 component=Npc path=plan value=duel_skeleton
act set id=e8 component=Npc path=behavior value=duel_fight
act set id=e8 component=Npc path=perception value=duel_eyes
act set id=e8 component=Npc path=director value=duel_spaced
act set id=e8 component=Npc path=plan value=duel_skeleton
act set id=e14 component=Npc path=behavior value=duel_fight
act set id=e14 component=Npc path=perception value=duel_eyes
act set id=e14 component=Npc path=director value=duel_spaced
act set id=e14 component=Npc path=plan value=duel_skeleton
step 2
invariant field e5 Health.current > 0

# --- 1. the skeletons wake: their first rest is a pause at spawn, then they take tokens
mark
act npc_set_state id=e7 state=idle
act npc_set_state id=e8 state=idle
act npc_set_state id=e14 state=idle
step 300 --until "journal:takes an attack token"
expect stopped "takes an attack token on e5"

# --- 2. the NPCs carry what the rules need and say so: the decision timer, the keep range
act npc_state id=e7
expect result contains "\"think\""
expect result contains "\"keep_range\": 24.0"

# --- 3. a long fight: the spacing holds every tick (the engine rule stops the step if not);
# three tokens are out, but the claws start apart
step 1800 --until named:three_attacking
expect result !contains "stopped: invariant"
expect journal "e7 -> e5 claw"
expect journal "e8 -> e5 claw"
expect journal "e14 -> e5 claw"
expect journal "returns its attack token after light"
act npc_state id=e8
expect result contains "\"strike\""

# --- 4. a noting-only NPC (E30): e7 strikes on a plan that ignores the spacing. Its claws are
# noted and hold e8 and e14 back as before, but it never waits itself; the engine rule keeps
# judging the others every tick
act content_apply changes='[{"kind": "attack_plan", "id": "duel_boss", "def": {"options": [{"input": "light", "tags": ["light"]}], "rest": [0.5, 0.8], "ignores_spacing": true}}]'
act set id=e7 component=Npc path=plan value=duel_boss
mark
step 900
expect result !contains "stopped: invariant"
expect journal "e7 -> e5 claw"
act npc_state id=e7
expect result !contains "waits_for"

# --- the pack stands down, and the world is as it was
act set id=e7 component=Npc path=behavior value=skeleton
act set id=e7 component=Npc path=perception value=skeleton
act set id=e7 component=Npc path=director value=""
act set id=e7 component=Npc path=plan value=skeleton
act set id=e8 component=Npc path=behavior value=skeleton
act set id=e8 component=Npc path=perception value=skeleton
act set id=e8 component=Npc path=director value=""
act set id=e8 component=Npc path=plan value=skeleton
act set id=e14 component=Npc path=behavior value=skeleton
act set id=e14 component=Npc path=perception value=skeleton
act set id=e14 component=Npc path=director value=""
act set id=e14 component=Npc path=plan value=skeleton
act npc_set_state id=e7 state=calm
act npc_set_state id=e8 state=calm
act npc_set_state id=e14 state=calm
act god on=false
act content_apply changes='[{"kind": "director", "id": "duel_spaced", "before": {"tokens": {"1": 3}, "waiting": [{"role": "Hold", "distance": 4.0}], "patience": 3.0, "min_spacing": 0.7, "spacing_exempt_tags": ["reposition"]}}, {"kind": "attack_plan", "id": "duel_skeleton", "before": {"options": [{"input": "light", "tags": ["light"], "when": [["!health_below", {"fraction": 0.05}]]}], "rest": [0.5, 0.8], "rest_interrupted": [0.2, 0.3], "first_rest": [0.2, 0.4]}}, {"kind": "behavior", "id": "duel_fight", "before": {"initial": "idle", "think": 0.15, "states": {"idle": {"transitions": [{"to": "fight", "when": ["target_known"]}]}, "fight": {"kind": "attack", "transitions": [{"to": "idle", "when": ["target_lost"]}]}}}}, {"kind": "perception", "id": "duel_eyes", "before": {"sight_range": 18.0, "fov_deg": 360.0, "near": 3.0, "hearing": 1.0, "memory": 6.0, "keep_range": 24.0}}, {"kind": "attack_plan", "id": "duel_boss", "before": {"options": [{"input": "light", "tags": ["light"]}], "rest": [0.5, 0.8], "ignores_spacing": true}}]'
act content_list kind=director
expect result !contains "duel_spaced"
# the swings in flight end and their tokens come back: the next scenario starts with a quiet arena
step 60
