// Plans of the scheduler tests (the gates of an option: angle, players, max_repeats, forbid_after).
{
    // Repeats: the light jab may be chosen twice in a row, the smash as often as it likes.
    "sched_repeats": (
        options: [(input: "light", weight: 3.0, max_repeats: Some(2)), (input: "heavy", weight: 1.0)],
        in_range_only: true,
        rest: (0.1, 0.1),
    ),
    // Angle: the smash answers a target behind, the jab a target in front. Chooses on decision ticks.
    "sched_angle": (
        options: [
            (input: "turn", weight: 1.0, angle: Some((95.0, 180.0))),
            (input: "light", weight: 1.0, angle: Some((0.0, 90.0))),
        ],
        in_range_only: true,
        press_on_decision: true,
        rest: (0.1, 0.1),
    ),
    // Two phases that share the option `light`: it rests 5 s after each swing, and never twice in a row.
    "sched_phase_1": (options: [(input: "light", cooldown: 5.0, max_repeats: Some(1)), (input: "heavy")], in_range_only: true, rest: (0.1, 0.1)),
    "sched_phase_2": (options: [(input: "light", cooldown: 5.0, max_repeats: Some(1)), (input: "turn", name: "spin")], in_range_only: true, rest: (0.1, 0.1)),
    // The far option only: a target 5 m away is walked up to.
    "sched_far": (options: [(input: "heavy", name: "far", min: 2.0, max: Some(3.0))], rest: (0.1, 0.1)),
    "sched_near": (options: [(input: "light", name: "near")], rest: (0.1, 0.1)),
    // Free, then strict: the strict plan would refuse a second jab in a row.
    "sched_free": (options: [(input: "light")], in_range_only: true, rest: (0.1, 0.1)),
    "sched_strict": (options: [(input: "light", max_repeats: Some(1))], in_range_only: true, rest: (0.1, 0.1)),
    // The draw: re-chosen on every tick among what fits.
    "sched_draw": (
        options: [(input: "light", weight: 3.0), (input: "heavy", weight: 1.0), (input: "turn", weight: 2.0, angle: Some((0.0, 90.0)))],
        in_range_only: true,
        rest: (0.1, 0.2),
    ),
    // The same draw on decision ticks only, with the choice kept in between (not in_range_only).
    "sched_decide": (
        options: [(input: "light", weight: 3.0, max: Some(3.0)), (input: "heavy", weight: 1.0, max: Some(3.0)), (input: "turn", weight: 2.0, max: Some(3.0), angle: Some((0.0, 90.0)))],
        rest: (0.1, 0.2),
    ),
    // Every gate at once.
    "sched_all": (
        options: [
            (input: "light", weight: 3.0, max_repeats: Some(2)),
            (input: "heavy", weight: 1.4, cooldown: 2.0, max_repeats: Some(1), tags: ["zone_center"], forbid_after: ["zone_center"]),
            (input: "turn", weight: 4.0, cooldown: 1.0, max_repeats: Some(1), angle: Some((95.0, 180.0))),
            (input: "heavy", name: "pair", weight: 1.0, players: Some((2, 3)), tags: ["zone_center"], forbid_after: ["zone_center"]),
        ],
        in_range_only: true,
        rest: (0.1, 0.2),
    ),

    // Plans of the tokenless tests (N8b). The boss fights without tokens, never waits for the spacing and
    // waits in a strafe of its own (2.4 m out, a side every second); its one option reaches 2.9 m, and it rests a second between attacks.
    "sched_boss": (
        options: [(input: "light", max: Some(2.9))],
        in_range_only: true,
        rest: (1.0, 1.0),
        tokenless: true,
        ignores_spacing: true,
        wait: Some((role: Strafe, distance: 2.4, speed: 1.0, orbit: 2.0, period: 1.0)),
    ),
    // The same boss that fights by the tokens like anyone: a counted twin, the control of the tests.
    "sched_boss_counted": (options: [(input: "light", max: Some(2.9))], in_range_only: true, rest: (1.0, 1.0)),
    // The same two with a short pause, to meet an add's attack in flight.
    "sched_boss_quick": (
        options: [(input: "light", max: Some(2.9))],
        in_range_only: true,
        rest: (0.5, 0.5),
        tokenless: true,
        wait: Some((role: Strafe, distance: 2.4, speed: 1.0, orbit: 2.0, period: 1.0)),
    ),
    "sched_boss_quick_counted": (options: [(input: "light", max: Some(2.9))], in_range_only: true, rest: (0.5, 0.5)),
    // An add: a plain jab by the tokens.
    "sched_add": (options: [(input: "light")], in_range_only: true, rest: (0.1, 0.1)),
    // Nothing in reach, ever (a window 8-9 m out, in range only): the NPC holds its grant and waits.
    "sched_stuck_boss": (
        options: [(input: "light", min: 8.0, max: Some(9.0))],
        in_range_only: true,
        rest: (0.1, 0.1),
        first_rest: Some((1.0, 1.0)),
        tokenless: true,
        wait: Some((role: Strafe, distance: 2.4, speed: 1.0, orbit: 2.0, period: 1.0)),
    ),
    // The same boss deciding on the NPC's decision ticks only (a behaviour with a `think` cadence).
    "sched_stuck_decide": (
        options: [(input: "light", min: 8.0, max: Some(9.0))],
        in_range_only: true,
        press_on_decision: true,
        rest: (0.1, 0.1),
        first_rest: Some((1.0, 1.0)),
        tokenless: true,
        wait: Some((role: Strafe, distance: 2.4, speed: 1.0, orbit: 2.0, period: 1.0)),
    ),
    "sched_stuck": (options: [(input: "light", min: 8.0, max: Some(9.0))], in_range_only: true, rest: (0.1, 0.1)),
    // An add that cannot be granted: its only option is on a long cooldown (planted by the test).
    "sched_cooled": (options: [(input: "light", cooldown: 99.0)], in_range_only: true, rest: (0.1, 0.1)),
}
