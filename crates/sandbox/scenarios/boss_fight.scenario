# The player fights the Frost Warden up to its second phase, the way an agent would: walk
# up, attack, watch the journal, step until something happens.
#
# The player is in god mode: this checks the rules of the fight (hits, the phase change at
# half health, the enraged moveset), not the player's luck in a fight nobody defends in.
# `combat_prototype.scenario` is the fight played to the end.

seed 42

# --- the arena as the game spawns it, whatever was played in it before: the skeletons stand
# down (their behaviour's `calm` state), and so does the warden until the fight begins
act npc_set_state id=e7 state=calm
act npc_set_state id=e8 state=calm
act npc_set_state id=e14 state=calm
act npc_set_state id=e6 state=calm
# (a dead player is brought back first: its own controls refuse a dead body)
act heal id=e5
act stop
act block on=false
act lock_on off=true
# whatever anyone was doing ends; the warden walks back to its post
step 150
act heal id=e5
act heal id=e6
act set id=e6 component=Boss path=phase value=1
act set id=e6 component=NpcPlan value='{"history": [], "cooldowns": [], "rest": 0.5, "attacks": 0}'
act teleport id=e5 x=0 z=12 y=0
act teleport id=e6 x=0 z=-6 y=0
act teleport id=e7 x=-18 z=18 y=0
act teleport id=e8 x=18 z=18 y=0
act teleport id=e14 x=-18 z=-18 y=0
act npc_set_state id=e6 state=guard
act god
invariant field e5 Health.current > 0

# --- 1. phase 1: the player walks up to the boss
expect shows e6 "phase 1"
expect field e6 Boss.phase == 1
act move_to target=e6 within=3
expect result contains "move_to e6"
step 900 --until near:e5:e6:3.2
expect stopped "within"

# --- 2. the first hit of a combo lands
act attack target=e6 repeat=true
expect result contains "attacking e6 with light until it dies"
step 600 --until "journal:e5 -> e6 light_1"
expect stopped "e5 -> e6 light_1"
expect journal "e5 -> e6 light_1 -20"
expect field e6 Health.current < 600

# --- 3. at half health the boss changes phase, however the health got there
mark
act set id=e6 component=Health path=current value=305
step 900 --until named:boss_phase_2
expect stopped "boss_phase_2"
expect journal "e6 phase 1->2"
expect shows e6 "phase 2"
expect field e6 Boss.phase == 2
expect field e6 Health.current <= 300

# --- 4. phase 2 goes on with the enraged moveset; the player is still up
step 300 --until "journal:e6 winds up"
expect stopped "_enraged"
expect !journal "e5 died"
observe
expect result contains "e5 Player"
expect result contains "phase 2"
act stop
act god on=false
