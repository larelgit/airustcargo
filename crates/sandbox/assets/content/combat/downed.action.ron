// Downed and revive (B5), for the `partner` moveset (`downed.moveset.ron`). Net ids 200-219.
{
    // The downed pose: it lies there for as long as it can be revived. The sandbox's lethal hook
    // bleeds it out when the pose's time runs out (20 s), unless a revive stands it up first.
    "spar_down": (net_id: 200, phases: [("down", 20.0)], anim: "death"),
    // The revive: held 3 s next to a downed ally (within 1.6 m plus its body, 1.2 m up or down,
    // any side), it stands the ally up with 30 % of its health and 1 s in which hits pass over it.
    // Letting go of interact, the ally lying more than 2 m off, or a hit that hurts the reviver
    // stops it. Nothing else holds the ally while it runs.
    "spar_revive": (
        net_id: 201,
        phases: [("revive", 3.0)],
        while_held: "interact",
        pair: (select: (team: Ally, state: Downed, range: 1.6, height: 1.2, angle: 180),
               exclusive: true, break_range: 2.0, cancel_on_hurt: true),
        effects: [(at: 3.0, effect: Revive(health: 0.3, grace: 1.0))],
    ),
}
