// How the sandbox is drawn (the engine's looks, E10.1): light in bands, outlines around what
// fights and what stands in the way, flat faces on the characters. A mesh takes the look its
// prefab names (`Look` in `characters/characters.prefab.ron`) or the one the sandbox's visuals
// give it (layout pieces by their `look`, noses, markers). Edit a colour here and the window
// changes as the file is saved; `shards act looks` lists what each look draws.
{
    // Presets the others extend: what a look leaves out comes from the one it extends.
    "low_poly": (flat: true, outline: Some((width: 2.0, color: "#0b0f1a"))),
    "cel": (shading: Toon(bands: 2)),

    "player": (extends: "low_poly", color: Some("#408cff"), outline: Some((width: 2.0, color: "#0b1a33"))),
    "skeleton": (extends: "low_poly", color: Some("#d9d1b3"), outline: Some((width: 2.0, color: "#2a2418"))),
    "warden": (extends: "low_poly", color: Some("#8cd9ff"), outline: Some((width: 3.0, color: "#0a2433"))),
    "stone": (color: Some("#61636e"), outline: Some((width: 1.5, color: "#16171c"))),
    "wall": (color: Some("#454754"), outline: Some((width: 1.5, color: "#16171c"))),
    "floor": (extends: "cel", color: Some("#2b303b")),
    "sand": (extends: "cel", color: Some("#8c8061")),
    "dark": (color: Some("#1a1a1f"), shading: Matte),
    "marker": (color: Some("#ffd933"), shading: Unlit),
    // What the wilds' scatter is drawn with (`region/wilds.scatter.ron`): no outline, so the
    // instances of a look are drawn together. The tufts darken toward their feet by themselves.
    "grass": (color: Some("#5fae45"), shading: Toon(bands: 2)),
    "grass_dry": (color: Some("#a7b04e"), shading: Toon(bands: 2)),
    "bush": (color: Some("#2f7a3a"), flat: true),
    "rock": (color: Some("#8a867c"), flat: true),
}
