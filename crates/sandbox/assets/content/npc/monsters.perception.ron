// What the monsters notice (content kind `perception`): sight through the world's colliders
// from the eyes, hearing of hits and sprints, memory of where a target was last.
{
    // All around, 18 m, not through walls or pillars; a hit or a sprint nearby is heard.
    "skeleton": (sight_range: 18.0, fov_deg: 360.0, near: 3.0, hearing: 1.0, memory: 6.0),
    // A boss knows its arena: 40 m, walls do not hide anyone from it.
    "boss": (sight_range: 40.0, fov_deg: 360.0, line_of_sight: false, memory: 2.0),
}
