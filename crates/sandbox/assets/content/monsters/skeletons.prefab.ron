// `Body` is also a physics component of the engine, so the sandbox's own is named by its path.
// Monsters defined in data: `shards act spawn_prefab id=skeleton_captain x=3 z=-4`.
// Components by name, values as in Bevy scenes; `extends` starts from another prefab.
{
    "skeleton": (
        components: {
            "Name": "Skeleton",
            "Skeleton": (),
            "AiKind": ("Skeleton"),
            "AiImportance": (1.0),
            "Team": Monster,
            "Health": (current: 40.0, max: 40.0),
            "sandbox::gameplay::combat::Body": (radius: 0.45, speed: 3.6),
            "SkeletonBrain": (aggro: 18.0, cooldown: 0.0),
            "Intent": (),
            "Action": Idle,
        },
    ),
    "skeleton_captain": (
        extends: "skeleton",
        components: {
            "Name": "Skeleton Captain",
            "AiImportance": (3.0),
            "Health": (current: 90.0, max: 90.0),
            "sandbox::gameplay::combat::Body": (radius: 0.5, speed: 3.2),
        },
    ),
}
