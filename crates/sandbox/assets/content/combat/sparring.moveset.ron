// The movesets `reactions.scenario` switches two arena fighters to (see `sparring.action.ron`), and
// the one `timeline.scenario` gives the player.
{
    // The skeleton's body, with reaction tiers: three reactions with their pushes, a short
    // immunity after each, protection when one ends, a guard-broken action.
    "sparring": (
        inputs: {"light": "claw", "heavy": "spar_slam", "dodge": "spar_roll", "block": "spar_guard", "technique.1": "spar_crusher"},
        stagger: "skeleton_stagger",
        hit: "skeleton_flinch",
        death: "skeleton_death",
        reactions: [
            (action: "spar_react_light", push: 2.0, decel: 12.0),
            (action: "spar_react_heavy", push: 4.0, decel: 12.0),
            (action: "spar_react_down", push: 4.0, decel: 12.0),
        ],
        reaction_immunity: 0.2,
        reaction_protection: 1.0,
        break_protection: 3.0,
        guard_broken: "spar_guard_broken",
        guard_broken_push: (0.2, 10.0),
    ),
    // The player's kit for it.
    "duelist": (
        inputs: {"light": "spar_jab", "heavy": "spar_slam", "dodge": "spar_roll", "block": "spar_guard", "technique.1": "spar_crusher"},
        stagger: "player_stagger",
        death: "player_death",
        reactions: [
            (action: "spar_react_light", push: 2.0, decel: 12.0),
            (action: "spar_react_heavy", push: 4.0, decel: 12.0),
            (action: "spar_react_down", push: 4.0, decel: 12.0),
        ],
        reaction_immunity: 0.2,
        reaction_protection: 1.0,
        guard_broken: "spar_guard_broken",
        guard_broken_push: (0.2, 10.0),
    ),
    // The player's kit for `timeline.scenario` (the action timeline, B2a): a heavy that charges
    // while held, a lunge and its variant on one cooldown, a channel that lasts while held, a roll
    // that keeps the facing; one press waits at a time, the stronger first.
    "timeline": (
        inputs: {
            "light": "spar_jab",
            "heavy": "spar_heavy",
            "dodge": "spar_roll_keep",
            "block": "spar_guard",
            "technique.1": "spar_lunge",
            "technique.2": "spar_lunge_far",
            "technique.3": "spar_channel",
        },
        stagger: "player_stagger",
        death: "player_death",
        buffer: SingleSlot(
            priority: [("dodge", 60), ("technique.1", 55), ("technique.2", 55), ("technique.3", 55), ("heavy", 40), ("light", 30)],
        ),
    ),
}
