// The flashes of the flash tests (U2, `flash.rs`).
{
    // A white flash of 0.6 s: 0.1 in, 0.2 held, 0.3 out.
    "reality": (color: "#ffffff", alpha: 0.9, fade_in_s: 0.1, hold_s: 0.2, fade_out_s: 0.3),
    // A glitch: 8 dips at 4 a second over a 2.5 s hold.
    "crack": (color: "#b8e6ff", alpha: 0.6, fade_in_s: 0.0, hold_s: 2.5, fade_out_s: 0.2, pulses: 8, pulse_rate: 4.0),
}
