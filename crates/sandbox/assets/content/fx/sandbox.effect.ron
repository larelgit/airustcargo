// The sandbox's effects (the engine's effects, E10.3; content kind `effect`): particles from a
// pool of `max_live` meshes made once, a soft spot (`Quad`), a `Cube`, a `Shard` or a level `Disc`. The table
// (sandbox.fx.ron) says which engine event plays which, and an effect's `intensity` how far past white its colour
// goes (for a camera with a bloom). `shards act effect_play effect=hit_spark at=e1` plays one by hand (in a
// window or with --offscreen), `shards act effects` lists them and their pools. Edit a number here and the next
// play takes it.
{
    // A hit: hot sparks that burst out of the struck side, back at the attacker, glowing, fading to red; three times
    // as bright as their colour, so the camera's bloom (camera.camera.ron) spreads a glow round them.
    "hit_spark": (count: 18, lifetime: (0.2, 0.4), speed: (3.0, 8.0), spread: 120.0, aim: Hit, lift: 35.0,
        gravity: -9.0, drag: 2.0, size: (0.2, 0.34), size_end: 0.3, color: "#fff2b3", color_end: "#ff6a1a00", glow: true,
        intensity: 3.0, offset: (0.0, 1.1, 0.0), radius: 0.15, max_live: 128),
    // A blow on a guard: cold shards of the guard that tumble off and fall.
    "block_spark": (count: 10, lifetime: (0.3, 0.5), speed: (2.5, 5.0), spread: 80.0, aim: Hit, lift: 35.0,
        gravity: -12.0, drag: 1.0, size: (0.2, 0.34), size_end: 0.4, color: "#bfe6ff", color_end: "#4d9fff00",
        shape: Shard, spin: 720.0, offset: (0.0, 1.2, 0.0), max_live: 64),
    // A parry: a white-gold flash, big and quick, all round.
    "parry_flash": (count: 24, lifetime: (0.12, 0.22), speed: (4.0, 8.0), spread: 360.0, drag: 6.0,
        size: (0.3, 0.45), size_end: 0.2, color: "#ffffff", color_end: "#ffd24d00", glow: true,
        offset: (0.0, 1.2, 0.0), max_live: 64),
    // A death: dust that rises from the body for a second, slows and settles.
    "death_dust": (count: 16, rate: 24.0, duration: 0.8, lifetime: (0.8, 1.4), speed: (0.4, 1.4), spread: 120.0,
        gravity: -0.6, drag: 1.5, size: (0.12, 0.22), size_end: 1.6, color: "#8c8061cc", color_end: "#5c554400",
        shape: Cube, spin: 90.0, radius: 0.5, offset: (0.0, 0.3, 0.0), max_live: 96),
    // A footstep (a clip's cue): a little dust that puffs off the ground and settles.
    "step_dust": (count: 4, lifetime: (0.3, 0.5), speed: (0.3, 0.8), spread: 160.0, lift: 20.0, gravity: -1.0,
        drag: 3.0, size: (0.06, 0.1), size_end: 1.8, color: "#8c806199", color_end: "#5c554400", shape: Cube,
        radius: 0.15, offset: (0.0, 0.05, 0.0), max_live: 48),
    // A heal: green motes that rise round the body for half a second.
    "heal_glow": (count: 8, rate: 30.0, duration: 0.6, lifetime: (0.6, 1.0), speed: (0.6, 1.4), spread: 25.0,
        size: (0.16, 0.26), size_end: 0.3, color: "#7dff9e", color_end: "#2bd96b00", glow: true, radius: 0.8,
        offset: (0.0, 0.4, 0.0), max_live: 48),
    // A guard that breaks: a pale ring at the waist that opens fast, slows and fades, in its own colour (a level disc,
    // `unlit`: it keeps its colour in any light and lies over what is behind it).
    "guard_ring": (count: 1, lifetime: (0.3, 0.3), speed: (0.0, 0.0), size: (1.0, 1.0), size_end: 4.0, size_ease: 2.5,
        color: "#ffb36bb3", shape: Disc, unlit: true, offset: (0.0, 0.9, 0.0), strength: (count_per: 0.0), max_live: 8),
    // A body that kicks off (a roll, a sprint's start; the game plays it with the body's way as `push`): dust that billows
    // before it thins and is carried off with a share of the push, and a bigger kick throws more of it, faster.
    "kick_dust": (count: 8, lifetime: (0.4, 0.6), speed: (0.4, 1.0), spread: 140.0, lift: 15.0, drag: 3.0,
        size: (0.12, 0.18), swell: 1.0, color: "#8c8061d9", shape: Cube, spin: 120.0, radius: 0.2, offset: (0.0, 0.05, 0.0),
        push: (0.6, 1.0), strength: (count_per: 4.0, speed: true, size: false), max_live: 64),
}
